# ─────────────────────────────────────────────────────────────
# Example configuration — copy to `.env` and fill in your values.
# Never commit real secrets: `.env` is git-ignored.
# In AWS, these values are injected as Lambda environment
# variables by Terraform (see infra/lambda.tf).
# ─────────────────────────────────────────────────────────────

# AWS
AWS_REGION=eu-north-1
ENV=dev
LOG_LEVEL=INFO

# Slack (Incoming Webhook + interactive buttons signature)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_CHANNEL=#devops-alerts
SLACK_SIGNING_SECRET=change-me

# Amazon Bedrock — FinOps routing: Haiku first, Sonnet if confidence is low
BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_SONNET_MODEL_ID=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_JUDGE_MODEL_ID=
BEDROCK_MAX_TOKENS=1024
BEDROCK_TEMPERATURE=0.1
BEDROCK_MAX_RETRIES=2
ROUTING_ESCALATION_THRESHOLD=50

# Guardrails
CONFIDENCE_THRESHOLD=85
AUTO_REMEDIATION_ENABLED=true
IDEMPOTENCY_TTL_SECONDS=120

# CloudWatch Logs (evidence for the diagnosis)
LOG_GROUP=/aws/ec2/agent-devops/app
LOG_LOOKBACK_SECONDS=1800
LOG_FETCH_MAX_EVENTS=200

# SSM Run Command
SSM_TIMEOUT_SECONDS=45
SSM_COMMAND_TIMEOUT_SECONDS=45
SSM_POLL_GRACE_SECONDS=5
SSM_POLL_INTERVAL_SECONDS=2

# DynamoDB tables
AGENT_DECISIONS_TABLE=agent_decisions
AGENT_DECISIONS_RETENTION_DAYS=90
ACTION_LOCKS_TABLE=agent_action_locks
CHECKPOINTS_TABLE=agent-devops-graph-checkpoints

# Chaos engineering campaigns (chaos/)
CHAOS_ASG_NAME=
